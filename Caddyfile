# Copy to /etc/caddy/Caddyfile on the Hetzner box.
# Replace yourdomain.com with your actual domain.
# Caddy auto-provisions and renews TLS.

yourdomain.com {
    # Serve report visualizations directly from host filesystem.
    # Stays live even if the Next.js container is restarting.
    handle /reports/* {
        root * /srv/talent-static
        file_server
    }

    # Everything else proxied to Next.js
    reverse_proxy localhost:3000
}
